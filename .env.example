# Copia este archivo como .env y rellénalo. Nunca lo subas con datos reales.
PORT=3000
DATA_DIR=/data
ADMIN_USER=admin
ADMIN_PASSWORD=cambia-esta-contrasena
API_KEY=cambia-esta-api-key
# Postgres: déjalo vacío para usar JSON en /data.
# Cuando quieras usar postgres_evo, pon aquí la URL con el usuario,
# contraseña y base reales (los ves en el stack whatsapp-bot de Portainer):
# DATABASE_URL=postgres://USUARIO:CONTRASENA@postgres_evo:5432/NOMBRE_DB
DATABASE_URL=
