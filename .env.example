# Copia este archivo como .env y rellénalo. Nunca lo subas con datos reales.
PORT=3000
DATA_DIR=/data
ADMIN_USER=admin
ADMIN_PASSWORD=cambia-esta-contrasena
API_KEY=cambia-esta-api-key
# Postgres: déjalo vacío para usar JSON en /data.
# Para usar Postgres real (BD separada de la de Evolution, se llama
# "cards_admin" y la crea el script de migración):
# DATABASE_URL=postgres://USUARIO:CONTRASENA@postgres_evo:5432/cards_admin
# Antes del primer arranque con DATABASE_URL, migra el JSON existente:
#   npm run migrate            (copia el JSON tal cual)
#   npm run migrate --init-empty   (instalación nueva, sin JSON)
# Ver README.md, sección "Migrar de JSON a Postgres".
DATABASE_URL=
